{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": true,
        ".validate": "$roomCode.length >= 4 && $roomCode.length <= 12",
        "movie": {
          ".validate": "newData.hasChildren(['url', 'at']) && newData.child('url').isString() && newData.child('url').val().length <= 2000",
          "sources": {
            "$quality": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            }
          },
          "qualities": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            }
          }
        },
        "playback": {
          ".validate": "newData.hasChildren(['type', 'currentTime', 'at']) && (newData.child('type').val() == 'play' || newData.child('type').val() == 'pause' || newData.child('type').val() == 'seek' || newData.child('type').val() == 'rate') && (!newData.hasChild('rate') || (newData.child('rate').isNumber() && newData.child('rate').val() >= 0.25 && newData.child('rate').val() <= 4))"
        },
        "chat": {
          "$msgId": {
            ".validate": "newData.hasChildren(['text', 'from', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        },
        "reactions": {
          "$msgId": {
            ".validate": "newData.hasChildren(['emoji', 'at']) && newData.child('emoji').isString() && newData.child('emoji').val().length <= 8"
          }
        },
        "presence": {
          "$clientId": {
            ".validate": "newData.hasChildren(['role', 'at']) && (newData.child('role').val() == 'host' || newData.child('role').val() == 'guest')"
          }
        },
        "pickingMovie": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
